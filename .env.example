# ---------------------------------------------------------------------------
# Contact form email (Hostinger SMTP). Copy to .env.local for local testing,
# and add the same names in hPanel → your Node.js app → Environment variables.
# Never commit real passwords. See docs/email-setup.md.
# ---------------------------------------------------------------------------

# Hostinger mailbox that sends the emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@steriqual.com
SMTP_PASS=your-mailbox-password

# Where new enquiry alerts go (comma-separate several addresses)
ENQUIRY_TO=info@steriqual.com
# Optional: people copied on every alert
ENQUIRY_CC=
# Optional: address customers reach when they reply to their confirmation (defaults to ENQUIRY_TO)
REPLY_TO=

# Google Sheet log: the Apps Script web app URL, and a shared secret that must match
# CONFIG.SECRET in integrations/google-apps-script/Code.gs
ENQUIRY_SHEET_WEBHOOK=
ENQUIRY_SHEET_SECRET=
